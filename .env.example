# Copy this file to .env and fill it in. .env is gitignored.

# Required on the laptop and the Space
OPENROUTER_API_KEY=

# Hugging Face: a WRITE token on the gaming PC, a READ token everywhere else
HF_TOKEN=
HF_DATA_REPO=TheMaskedOne/kerbal-copilot-data

# Memory that survives Space restarts (leave empty to use a local SQLite file)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Login for the web app (strongly recommended on the public Space)
APP_USERNAME=
APP_PASSWORD=

# Optional extras
TAVILY_API_KEY=
GROQ_API_KEY=

# 45 fits the 50/day free cap. Raise to 950 after buying 10 OpenRouter credits.
DAILY_REQUEST_BUDGET=45
